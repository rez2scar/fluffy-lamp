Library.h
#ifndef LIBRARY_H
#define LIBRARY_H

#include "Book.h"
#include "User.h"

class Library {
private:
    Book books[10];
    User users[5];
    int bookCount;
    int userCount;

public:
    Library();

    void addBook(Book b);
    void addUser(User u);

    void borrowBook(int userId, int bookId);
    void returnBook(int bookId);
};

#endif
Library.cpp
#include "Library.h"
#include <iostream>
using namespace std;

Library::Library() {
    bookCount = 0;
    userCount = 0;
}

void Library::addBook(Book b) {
    books[bookCount] = b;
    bookCount++;
}

void Library::addUser(User u) {
    users[userCount] = u;
    userCount++;
}

void Library::borrowBook(int userId, int bookId) {
    for (int i = 0; i < bookCount; i++) {
        if (books[i].getId() == bookId && !books[i].isBorrowed()) {
            books[i].borrow();
            cout << "Book borrowed successfully\n";
            return;
        }
    }
    cout << "Book not available\n";
}

void Library::returnBook(int bookId) {
    for (int i = 0; i < bookCount; i++) {
        if (books[i].getId() == bookId) {
            books[i].giveBack();
            cout << "Book returned\n";
            return;
        }
    }
}

main.cpp
#include "Library.h"

int main() {
    Library lib;

    Book b1(1, "C++ Basics", "John");
    User u1(101, "Alice");

    lib.addBook(b1);
    lib.addUser(u1);

    lib.borrowBook(101, 1);
    lib.borrowBook(101, 1);   // should fail
    lib.returnBook(1);

    return 0;
}
